# These are the SDKs that are used by all configurations
Imports:
- ../core_project/core_project.yaml
- ../../../../../../sdk/nvidia/nvtt/923b57d/nvtt.yaml
- ../ImageIO/uses_ImageIO.yaml

# Settings from the General section, for all configurations
General:
  ConfigurationType: DynamicLibrary
  UseOfMfc: false

ClCompile:
  WarningLevel: Level3
  TreatWarningAsError: true
  BufferSecurityCheck: false
  AdditionalIncludeDirectories:
  - .
  - ..
  PrecompiledHeader: Use
  PrecompiledHeaderFile: StdAfx.h
  PrecompiledHeaderOutputFile: $(IntDir)$(TargetName).pch

Link:
  GenerateDebugInformation: true
  ProgramDatabaseFile: $(TargetDir)$(TargetName).pdb

BaseConfigurations:
  Windows:
    Imports:
    - ../../../../../../sdk/zlib/1.2.11/zlib_1.2.11.yaml
    - ../BlueExposure/uses_BlueExposureStatic.yaml

  Mac:
    Imports:
    - ../../../../../../sdk/zlib/1.2.11/zlib_1.2.11.yaml
    - ../BlueExposure/uses_BlueExposure.yaml

  Release:
    General:
      TargetName: _imagetools
      TargetExt: .pyd
    ClCompile:
      Optimization: MaxSpeed
  
  ExeFile:
    Imports:
    - ../stackless/stackless.yaml
    General: 
      OutDir: ../../autobuild/ImageTools/exefile/$(Platform)/$(PlatformToolset)/
      IntDir: ../temp/ImageTools/exefile/$(Platform)/$(Configuration)/$(PlatformToolset)/
      TargetExt: .dll
  
  Python27:
    Imports:
    - ../../../../../../sdk/python/ccpproj/Python_2.7.yaml
    General:
      OutDir: ../../autobuild/ImageTools/python_27/$(Platform)/$(PlatformToolset)/
      IntDir: ../temp/ImageTools/python_27/$(Platform)/$(Configuration)/$(PlatformToolset)/
      TargetExt: .pyd

Configurations:
  Release|Win32,x64:
    BaseConfigurations:
    - Release
    - ExeFile
    - Windows
    
  Release_27|Win32,x64:
    BaseConfigurations:
    - Release
    - Python27
    - Windows
  
  Release|Mac64:
    BaseConfigurations:
    - Release
    - ExeFile
    - Mac
    
  Release_27|Mac64:
    BaseConfigurations:
    - Release
    - Python27
    - Mac
